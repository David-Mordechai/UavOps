<Project Sdk="Microsoft.NET.Sdk">

  <!-- One-off builder for UavOps.Simulator's offline satellite basemap and terrain
       (scripts/build-satellite.ps1). Not part of the running system. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <PackageReference Include="SkiaSharp" Version="4.152.1" />
  </ItemGroup>

  <!-- The same projection code the simulator uses to read its aerial photos. -->
  <ItemGroup>
    <Compile Include="..\..\src\UavOps.Simulator\imagery\Utm.cs" Link="Shared\Utm.cs" />
    <Compile Include="..\..\src\UavOps.Simulator\Map\TileMath.cs" Link="Shared\TileMath.cs" />
  </ItemGroup>

</Project>
