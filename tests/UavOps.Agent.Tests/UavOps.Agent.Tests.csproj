<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="FluentAssertions" Version="8.10.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="NSubstitute" Version="6.0.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- xUnit v2 reads this from next to the test assembly at runtime, not from the source tree -
         must be copied to the output directory the same way appsettings.json/ToolsConfig.yaml
         already are for the Mcp* projects. Caps how many test collections (effectively: how many
         Category=Live classes) run concurrently - see the file's own placement in this session's
         GX10 investigation for why: this app's live tests share ONE physical GPU (via the GX10's
         two vLLM engines) with nothing else running interactively, and real vLLM engine logs
         showed genuine request queueing (Waiting up to 8) and heavy batching (Running up to 10-11)
         specifically when every live test class ran fully unbounded in parallel - individual
         completions that normally take 1-8s stretched past the OpenAI SDK's 100-second default
         timeout under that load. Fully sequential (1 at a time) avoids contention but is too slow
         for iterative use; this bounds concurrency to a middle ground instead of an all-or-nothing
         choice. 4 is a starting point, not a proven-optimal number - tune it based on real GX10
         load if timeouts/slow runs recur or if the suite still feels too slow. -->
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\UavOps.Agent\UavOps.Agent.csproj" />
    <ProjectReference Include="..\..\src\UavOps.Agent.Contracts\UavOps.Agent.Contracts.csproj" />
    <ProjectReference Include="..\..\src\UavOps.Agent.McpMoav\UavOps.Agent.McpMoav.csproj" />
    <ProjectReference Include="..\..\src\UavOps.Agent.McpSimulator\UavOps.Agent.McpSimulator.csproj" />
    <ProjectReference Include="..\..\src\UavOps.Agent.McpWatchdog\UavOps.Agent.McpWatchdog.csproj" />
    <ProjectReference Include="..\..\src\UavOps.Agent.Simulator.Fake\UavOps.Agent.Simulator.Fake.csproj" />
    <ProjectReference Include="..\..\src\UavOps.Agent.Watchdog.Fake\UavOps.Agent.Watchdog.Fake.csproj" />
  </ItemGroup>

</Project>
