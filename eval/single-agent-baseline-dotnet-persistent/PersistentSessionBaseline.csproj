<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>MEAI001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same versions/construction path as ../single-agent-baseline-dotnet, plus
         InMemoryChatHistoryProvider/MessageCountingChatReducer - the one variable this project adds
         on top of that baseline, to isolate whether the real app's PERSISTENT, never-recreated
         session (reused across the app's entire lifetime, accumulating and reducer-trimmed history)
         is itself the differentiator, independent of prompt size, tool count, and retrieval (all
         already ruled out - see this project's own Program.cs top-of-file comment). -->
    <PackageReference Include="Microsoft.Agents.AI" Version="1.13.0" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.8.0" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.8.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.8.0" />
  </ItemGroup>

</Project>
