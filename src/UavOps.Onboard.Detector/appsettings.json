{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5280",

  "Vlm": {
    "Endpoint": "http://192.168.1.152:8000/v1",
    "Model": "nvidia/Qwen3.6-35B-A3B-NVFP4",
    "TimeoutSeconds": 60,
    "MaxTokens": 900,
    "DisableThinking": true
  },

  "Detector": {
    "MaxConcurrentFrames": 6,
    "MaxCandidatesPerFrame": 20,
    "TrackRadiusMeters": 25,
    "ZoomPixels": 320,
    "SameObjectMeters": 4,
    "FramePollWaitMs": 10000
  }
}
