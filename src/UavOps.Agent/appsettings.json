{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5262",

  "Ollama": {
    "Endpoint": "http://localhost:11434",
    "DefaultModel": "granite4.1:3b"
  },

  "OpenAI": {
    "Endpoint": "http://192.168.1.152:8000/v1"
  },

  "Embedding": {
    "Endpoint": "http://192.168.1.152:8001/v1",
    "Model": "Qwen/Qwen3-Embedding-8B"
  },

  "Voice": {
    "SttEnglishEndpoint": "http://192.168.1.152:8010",
    "SttHebrewEndpoint": "http://192.168.1.152:8011",
    "TtsEndpoint": "http://192.168.1.152:8003",
    "HttpTimeoutSeconds": 30
  },

  "AgentModels": {
    "Provider": "OpenAI",
    "Model": "nvidia/Qwen3.6-35B-A3B-NVFP4"
  },

  "Retrieval": {
    "TopK": 10,
    "MaxScoreGapFromBest": 0.25,
    "ClauseTopK": 5
