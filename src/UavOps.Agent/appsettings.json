{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5262",

  "Ollama": {
    "Endpoint": "http://localhost:11434",
    "DefaultModel": "granite4.1:3b"
  },

  "OpenAI": {
    "Endpoint": "http://192.168.1.152:8000/v1"
  },

  "Embedding": {
    "Endpoint": "http://192.168.1.152:8001/v1",
    "Model": "Qwen/Qwen3-Embedding-8B"
  },

  "Voice": {
    "SttEnglishEndpoint": "http://192.168.1.152:8010",
    "SttHebrewEndpoint": "http://192.168.1.152:8011",
    "TtsEndpoint": "http://192.168.1.152:8003",
    "SttEnglishPrompt": "UAV fleet control commands, e.g. Send UAV 997 to alpha. Point 998's payload at bravo. Zoom 999 to 10x. Tail numbers 997, 998, 999. Zones ZoneA, ZoneB. Points alpha, bravo, home.",
    "HttpTimeoutSeconds": 30
  },

  "AgentModels": {
    "Provider": "OpenAI",
    "Model": "nvidia/Qwen3.6-35B-A3B-NVFP4"
  },

  "Retrieval": {
    "TopK": 10,
    "MaxScoreGapFromBest": 0.25,
    "ClauseTopK": 5,
    "MaxHistoryChars": 4000
  },

  "Memory": {
    "MaxHistoryMessages": 40
  },

  "RemoteOperation": {
    "TimeoutSeconds": 10
  },

  "ExecutionMode": "Confirm",

  "McpServerPaths": {
    "moav": "",
    "watchdog": "",
    "simulator": ""
  }
}
