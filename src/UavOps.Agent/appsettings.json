{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Ollama": {
    "Endpoint": "http://localhost:11434",
    "DefaultModel": "granite4.1:3b",
    "EmbeddingModel": "InMemory"
  },

  "Retrieval": {
    "MaxDelegatesPerAgent": 5,
    "MaxDelegationDepth": 2
  },

  "OperationBackend": "Simulated",
  "RemoteOperation": {
    "TimeoutSeconds": 10
  },

  "ExecutionMode": "Confirm"
}
