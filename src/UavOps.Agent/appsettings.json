{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Ollama": {
    "Endpoint": "http://localhost:11434",
    "DefaultModel": "granite4.1:3b",
    "EmbeddingModel": "InMemory"
  },

  "OpenAI": {
    "Endpoint": "https://openrouter.ai/api/v1"
  },

  "AgentModels": {
    "BrainAgent": { "Provider": "Ollama", "Model": "granite4.1:3b" },
    "MoavAgent": { "Provider": "Ollama", "Model": "granite4.1:3b" },
    "FlightControlAgent": { "Provider": "Ollama", "Model": "granite4.1:3b" },
    "PayloadControlAgent": { "Provider": "Ollama", "Model": "granite4.1:3b" },
    "GdtControlAgent": { "Provider": "Ollama", "Model": "granite4.1:3b" },
    "MissionAgent": { "Provider": "Ollama", "Model": "granite4.1:3b" },
    "SimulatorAgent": { "Provider": "Ollama", "Model": "granite4.1:3b" },
    "SimulatorInfrastructureAgent": { "Provider": "Ollama", "Model": "granite4.1:3b" },
    "MaintenanceAgent": { "Provider": "Ollama", "Model": "granite4.1:3b" },
    "WatchdogServiceAgent": { "Provider": "Ollama", "Model": "granite4.1:3b" },
    "WatchdogConfigAgent": { "Provider": "Ollama", "Model": "granite4.1:3b" }
  },

  "Retrieval": {
    "MaxDelegatesPerAgent": 5,
    "MaxDelegationDepth": 2
  },

  "OperationBackend": "Simulated",
  "RemoteOperation": {
    "TimeoutSeconds": 10
  },

  "SimulatorBackend": "Fake",
  "Simulator": {
    "VmwareExecutablePath": "",
    "VmwareProcessName": "vmware",
    "VmrunExecutablePath": "",
    "SimulatorVmxPath": "",
    "NetworkAdapterDeviceNames": [],
    "LessonsFolder": "",
    "HostReadyTimeoutSeconds": 60,
    "VmToolsReadyTimeoutSeconds": 180,
    "ReadyPollIntervalSeconds": 2
  },

  "WatchdogBackend": "Real",
  "Watchdog": {
    "HealthCheckUrl": "",
    "PollIntervalSeconds": 3,
    "HttpTimeoutSeconds": 5,
    "ServiceControlTimeoutSeconds": 30,
    "ServiceNameMap": {
      "Moav.Watchdog.Service": "Moav.Watchdog.Service"
    },
    "ServiceConfigBasePath": "C:\\WatchdogConfigTest",
    "ServiceConfigFileName": "config.yml",
    "ExecutablePlaceholders": {
      "%MoavHome%": "C:\\Moav",
      "%MoavProducts%": "C:\\Moav\\product\\build_products"
    }
  },

  "ExecutionMode": "Confirm"
}
