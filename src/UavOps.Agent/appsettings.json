{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Ollama": {
    "Endpoint": "http://localhost:11434",
    "DefaultModel": "granite4.1:3b"
  },

  "OpenAI": {
    "Endpoint": "http://10.10.77.57:8000/v1"
  },

  "Embedding": {
    "Endpoint": "http://10.10.77.57:8001/v1",
    "Model": "Qwen/Qwen3-Embedding-8B"
  },

  "AgentModels": {
    "Provider": "OpenAI",
    "Model": "nvidia/Qwen3.6-35B-A3B-NVFP4"
  },

  "Retrieval": {
    "TopK": 10
  },

  "Memory": {
    "MaxHistoryMessages": 40
  },

  "OperationBackend": "Simulated",
  "RemoteOperation": {
    "TimeoutSeconds": 10
  },

  "SimulatorBackend": "Fake",
  "Simulator": {
    "VmwareExecutablePath": "",
    "VmwareProcessName": "vmware",
    "VmrunExecutablePath": "",
