        <mxCell id="ollama" value="Ollama (local)&#10;http://localhost:11434&#10;chat model, e.g. granite4.1:3b&#10;(dev default)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#D9F2E6,#1F4A3D);strokeColor=light-dark(#4DA88F,#7FD9BE);fontColor=light-dark(#1A1A1A,#F5F5F5);fontSize=12;fontStyle=1;arcSize=10;" vertex="1" parent="1">
