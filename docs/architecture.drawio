        <!-- Cross-phase dependency: the index built once is what every turn compares against -->
        <mxCell id="t_e8" value="compares against" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=none;dashed=1;strokeColor=light-dark(#555555,#BBBBBB);strokeWidth=2;fontColor=light-dark(#1A1A1A,#F5F5F5);fontSize=13;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="t_index" target="t_cosine">
