<mxfile host="app.diagrams.net" agent="Claude Code" version="24.0.0">
  <diagram name="System Architecture" id="uavops-architecture">
    <mxGraphModel dx="1800" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1300" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===================== TITLE ===================== -->
        <mxCell id="title" value="UavOps — Natural-Language UAV Command &amp; Control: System Architecture" style="text;html=1;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;fontColor=light-dark(#1A1A1A,#F5F5F5);" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1720" height="32" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Local-LLM agent layer (.NET 8) &#8226; three MCP domain servers, each a separate process &#8226; no traditional database" style="text;html=1;fontSize=13;fontStyle=2;align=center;verticalAlign=middle;fontColor=light-dark(#5A5A5A,#B5B5B5);" vertex="1" parent="1">
          <mxGeometry x="40" y="42" width="1720" height="22" as="geometry" />
        </mxCell>

        <!-- ===================== ACTORS ===================== -->
        <mxCell id="actor_browser" value="Operator&#10;(Web Browser SPA)&#10;chat.js / graph.js" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#F5F5F5,#2B2B2B);strokeColor=light-dark(#666666,#AAAAAA);fontColor=light-dark(#1A1A1A,#F0F0F0);fontSize=12;fontStyle=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="88" width="260" height="72" as="geometry" />
        </mxCell>
        <mxCell id="actor_fleet" value="Real Fleet-Commanding App&#10;(.NET Framework 4.7, UavOps.FleetClient)&#10;— or UavOps.MockFleetClient (dev) —" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#F5F5F5,#2B2B2B);strokeColor=light-dark(#666666,#AAAAAA);fontColor=light-dark(#1A1A1A,#F0F0F0);fontSize=12;fontStyle=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1480" y="88" width="280" height="72" as="geometry" />
        </mxCell>

        <!-- ===================== HOST BACKDROP ===================== -->
        <mxCell id="host_backdrop" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#EAF2FB,#152238);strokeColor=light-dark(#6C8EBF,#3D5A80);dashed=1;arcSize=4;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="1720" height="450" as="geometry" />
        </mxCell>
        <mxCell id="host_title" value="UavOps.Agent — single long-running ASP.NET Core host (.NET 8) &#183; http://localhost:5262" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;fontColor=light-dark(#1A1A1A,#F5F5F5);" vertex="1" parent="1">
          <mxGeometry x="60" y="206" width="900" height="24" as="geometry" />
        </mxCell>

        <mxCell id="chathub" value="ChatHub&#10;(one class, two endpoints)&#10;/chatHub  +  /uavCommandHub" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#DAE8FC,#1F3A5F);strokeColor=light-dark(#6C8EBF,#8FB4E3);fontColor=light-dark(#1A1A1A,#F5F5F5);fontSize=12;fontStyle=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="760" y="244" width="280" height="70" as="geometry" />
        </mxCell>

        <mxCell id="orchestrator" value="MainAgentOrchestrator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#DAE8FC,#1F3A5F);strokeColor=light-dark(#6C8EBF,#8FB4E3);fontColor=light-dark(#1A1A1A,#F5F5F5);fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="760" y="336" width="280" height="46" as="geometry" />
        </mxCell>

        <mxCell id="brainagent" value="AgentFactory&#10;+ BrainAgent (persistent ChatClientAgent, one flat agent)&#10;+ ToolRetrievalIndex (embedding-based top-K narrowing)&#10;+ ToolCallAwareChatReducer (bounded, tool-call-safe history)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#DAE8FC,#1F3A5F);strokeColor=light-dark(#6C8EBF,#8FB4E3);fontColor=light-dark(#1A1A1A,#F5F5F5);fontSize=12;fontStyle=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="420" y="410" width="470" height="110" as="geometry" />
        </mxCell>

        <mxCell id="gates" value="ConfirmationGate  &#183;  OperatorPromptGate&#10;TailNumberDisambiguationTool&#10;+ TailNumberResolutionScope&#10;(per-turn, keyed by guessed tail number)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#DAE8FC,#1F3A5F);strokeColor=light-dark(#6C8EBF,#8FB4E3);fontColor=light-dark(#1A1A1A,#F5F5F5);fontSize=12;fontStyle=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="920" y="410" width="360" height="110" as="geometry" />
        </mxCell>

        <mxCell id="toollogger" value="ToolInvocationLogger&#10;(structured logs +&#10;live trace events)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#DAE8FC,#1F3A5F);strokeColor=light-dark(#6C8EBF,#8FB4E3);fontColor=light-dark(#1A1A1A,#F5F5F5);fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="1310" y="424" width="220" height="80" as="geometry" />
        </mxCell>

        <mxCell id="host_note" value="Tools are rebuilt fresh every turn, sourced entirely from the 3 connected MCP servers (below) via the ModelContextProtocol client — no domain/tool logic runs in-process here anymore." style="text;html=1;fontSize=11;fontStyle=2;align=left;verticalAlign=middle;fontColor=light-dark(#5A5A5A,#B5B5B5);" vertex="1" parent="1">
          <mxGeometry x="420" y="530" width="1000" height="30" as="geometry" />
        </mxCell>

        <!-- ===================== MCP SERVERS ===================== -->
        <mxCell id="mcpmoav" value="UavOps.Agent.McpMoav&#10;(stdio MCP server — separate process)&#10;&#10;12 fleet ops: ListFleet, Navigate, SetSpeed, SetAltitude,&#10;ReturnToLaunch, PointPayload, ResetPayload, UploadWaypoints,&#10;GetMissionStatus, GetLinkStatus, SetTrackingMode, GetTelemetry&#10;&#10;own ToolsConfig.yaml (all AI wording, hot-editable)&#10;OperationBackend: Simulated (in-memory)  |  SignalR (relay)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#E6D9F2,#3B2A55);strokeColor=light-dark(#9673A6,#C6A8DE);fontColor=light-dark(#1A1A1A,#F5F5F5);fontSize=11;fontStyle=1;arcSize=6;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="700" width="540" height="160" as="geometry" />
        </mxCell>

        <mxCell id="mcpwatchdog" value="UavOps.Agent.McpWatchdog&#10;(stdio MCP server — separate process)&#10;&#10;4 health ops: GetServicesHealth, Start/Stop/RestartService&#10;5 config ops: List/AddConfiguredService, UpdateConfiguredService,&#10;RemoveConfiguredService, ListConfigurations&#10;&#10;own ToolsConfig.yaml (all AI wording, hot-editable)&#10;WatchdogBackend: Fake (in-memory)  |  Real" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#E6D9F2,#3B2A55);strokeColor=light-dark(#9673A6,#C6A8DE);fontColor=light-dark(#1A1A1A,#F5F5F5);fontSize=11;fontStyle=1;arcSize=6;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="630" y="700" width="540" height="160" as="geometry" />
        </mxCell>

        <mxCell id="mcpsimulator" value="UavOps.Agent.McpSimulator&#10;(stdio MCP server — separate process)&#10;&#10;4 ops + AskOperatorWhichLesson: EnsureVmwareHostRunning,&#10;EnsureSimulatorVmRunning, ListSimulatorLessons,&#10;RunSimulatorLesson (queued, background job processor)&#10;&#10;own ToolsConfig.yaml (all AI wording, hot-editable)&#10;SimulatorBackend: Fake (in-memory)  |  Real (VMware)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#E6D9F2,#3B2A55);strokeColor=light-dark(#9673A6,#C6A8DE);fontColor=light-dark(#1A1A1A,#F5F5F5);fontSize=11;fontStyle=1;arcSize=6;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1200" y="700" width="540" height="160" as="geometry" />
        </mxCell>

