        <!-- ===================== STORAGE / CONFIG NOTE ===================== -->
        <mxCell id="storage" value="Persistence — no database engine&#10;&#10;&#8226; BrainAgent.yaml + 3&#215; ToolsConfig.yaml: every AI-facing string (instructions, tool &amp;&#10;   parameter descriptions) — hot-editable, no recompile needed&#10;&#8226; appsettings.json (host + each MCP server has its own) + user-secrets: API keys, endpoints&#10;&#8226; Watchdog service-config YAML files (Real backend only)&#10;&#8226; Serilog file logs — src/UavOps.Agent/logs/*.log&#10;&#8226; All UAV / watchdog / simulator STATE is in-memory (Fake/dev backends) or owned entirely&#10;   by the real external system (Real backends) — this app never persists it itself" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#FFF7E0,#332B12);strokeColor=light-dark(#C9A227,#C9A227);dashed=1;fontColor=light-dark(#1A1A1A,#F5F5F5);fontSize=12;fontStyle=1;arcSize=6;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
