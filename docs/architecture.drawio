        <mxCell id="e3" value="MCP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=none;strokeColor=light-dark(#7A4E96,#C6A8DE);strokeWidth=2;fontColor=light-dark(#1A1A1A,#F5F5F5);fontSize=14;exitX=0.2;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="host" target="moav">
